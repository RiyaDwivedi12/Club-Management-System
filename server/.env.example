# Server Environment Configuration Template
# Duplicate this file as .env and fill in your actual production values

PORT=5000
NODE_ENV=production

# MongoDB Atlas connection URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/club-management?retryWrites=true&w=majority

# Client URLs (comma-separated if multiple, e.g. for both local and deployed frontend)
CLIENT_URL=https://your-frontend-app.netlify.app

# Authentication Secrets
JWT_SECRET=replace_with_a_secure_random_string_32_chars_or_more
ADMIN_SECRET=admin123
FACULTY_SECRET=faculty123
PRESIDENT_SECRET=president123
VICE_PRESIDENT_SECRET=vp123
REFEREE_SECRET=referee123

# Razorpay Payment Gateway (Optional for testing)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# Nodemailer / Email Service (Gmail SMTP with App Password)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
